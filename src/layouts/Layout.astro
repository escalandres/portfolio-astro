---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { PROFILE } from "../data/profile";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  locale?: string;
  type?: "website" | "project";
  path?: string;
}

const {
  title,
  description = "Portfolio of Andres Escala, Software Engineer & Technical Consultant.",
  canonical,
  ogImage,
  locale = "en",
  type = "website",
  path = "",
} = Astro.props;

const site = Astro.site;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site ?? Astro.url).toString();
const pageUrl = new URL(Astro.url.pathname, site ?? Astro.url).toString();
const rawPath = Astro.url.pathname.replace(/\/$/, "");
let enPath = "/en";
let esPath = "/es";

if (rawPath.startsWith("/es/proyectos/") || rawPath.startsWith("/en/projects/")) {
  const slug = rawPath.split("/").pop();
  enPath = `/en/projects/${slug}`;
  esPath = `/es/proyectos/${slug}`;
} else if (rawPath === "/es" || rawPath === "/en" || rawPath === "") {
  enPath = "/en";
  esPath = "/es";
} else {
  const sub = rawPath.replace(/^\/(en|es)/, "");
  enPath = `/en${sub}`;
  esPath = `/es${sub}`;
}

const enUrl = new URL(enPath, site ?? Astro.url).toString();
const esUrl = new URL(esPath, site ?? Astro.url).toString();
const xDefaultUrl = new URL("/en", site ?? Astro.url).toString();
const ogImageUrl = ogImage
  ? site
    ? new URL(ogImage, site).toString()
    : new URL(ogImage, Astro.url).toString()
  : site
    ? new URL("/andres.webp", site).toString()
    : undefined;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.name,
  jobTitle: PROFILE.title,
  description: "NetSuite Technical Consultant & Solution Architect with 4 years of software engineering experience: SuiteScript 2.1, SuiteTalk, RESTlets, ERP integrations and LATAM fiscal localizations across 20+ enterprise projects.",
  sameAs: [PROFILE.linkedin, PROFILE.github, "https://aes-studio.dev/"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `Andres Escala — ${PROFILE.title}`,
  url: site ? new URL("/", site).toString() : undefined,
  inLanguage: ["en", "es"],
};

const ogLocale = locale === "es" ? "es_MX" : "en_US";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Andres Escala" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta name="theme-color" content="#eef3fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1530" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <canvas class="d2-page-canvas" aria-hidden="true"></canvas>
    <div class="glow" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <Header locale={locale} path={path} />
    <main id="main-content" class="wrap">
      <slot />
    </main>
    <Footer locale={locale} />
    <div id="t" role="status" aria-live="polite"></div>
    <script type="module" src="/js/scripts.js"></script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
</style>
