---
import { getProjects } from "../data/projects";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const currentLocale = (locale === "es" ? "es" : "en") as "en" | "es";
const t = getTranslations(currentLocale as Locale);
const projects = getProjects(currentLocale);

const labels = currentLocale === "es"
  ? { demo: "Ver demo ↗", code: "Código ↗", download: "Descargar ↗", play: "Jugar ↗" }
  : { demo: "Live demo ↗", code: "Source ↗", download: "Download ↗", play: "Play ↗" };
---

<section id="proyectos">
  <div class="eyebrow">{t.projects.eyebrow}</div>
  <h2>{t.projects.title}</h2>
  <p class="sub">{t.projects.subtitle}</p>

  <div class="grid">
    {
      projects.map((p, i) => (
        <article class:list={["card", "pr", "rv", { big: p.big }]} style={`--d:${(i % 3) * 70}ms`}>
          <img class="shot" src={p.screenshot} alt={p.title} loading="lazy" />
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <div class="chips">
            {p.stack.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
          <div class="ft">
            {p.links.demo && <a href={p.links.demo} target="_blank" rel="noopener noreferrer">{labels.demo}</a>}
            {p.links.github && <a href={p.links.github} target="_blank" rel="noopener noreferrer">{labels.code}</a>}
            {p.links.download && <a href={p.links.download} target="_blank" rel="noopener noreferrer">{labels.download}</a>}
            {p.links.play && <a href={p.links.play} target="_blank" rel="noopener noreferrer">{labels.play}</a>}
          </div>
        </article>
      ))
    }
  </div>
</section>
