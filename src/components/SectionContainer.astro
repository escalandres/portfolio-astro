---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  class?: string;
}

const { id, title, description, class: className } = Astro.props;
---

<section id={id} data-section={id} class:list={["section", className]}>
  <div class="wrap">
    {
      (title || description) && (
        <header class="section-header reveal">
          {title && <h2 class="section-title">{title}</h2>}
          {description && <p class="section-lead">{description}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
