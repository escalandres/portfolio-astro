---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale as Locale);
const items = t.experienceContent.items;
const current = locale === "es" ? "Actualidad" : "Present";
---

<section id="experiencia">
  <div class="eyebrow">{locale === "es" ? "Trayectoria" : "Career"}</div>
  <h2>{t.experienceContent.heading}</h2>
  <p class="sub">
    {
      locale === "es"
        ? "De prácticas a consultoría técnica en una de las empresas de software más grandes del mundo."
        : "From internships to technical consulting at one of the world's largest software companies."
    }
  </p>

  <div class="tl">
    {
      items.map((item, i) => (
        <div class="job rv" style={`--d:${i * 70}ms`}>
          <small>
            {item.period}
            {item.current && ` · ${current}`}
          </small>
          <h3>{item.role}</h3>
          <em>{item.company}</em>
          <p>{item.points.slice(0, 2).join(" ")}</p>
        </div>
      ))
    }
  </div>
</section>
