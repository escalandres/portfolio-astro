---
import { getTranslations, localizedPath, type Locale } from "../i18n";

interface Props {
  locale: string;
  path?: string;
}

const { locale, path = "" } = Astro.props;
const t = getTranslations(locale as Locale);

const links = [
  { href: "#experiencia", label: t.nav.experience },
  { href: "#aes-studio", label: t.overview.title },
  { href: "#certificaciones", label: t.nav.education },
  { href: "#proyectos", label: t.nav.projects },
  { href: "#contacto", label: t.nav.contact },
];
---

<header class="site-header">
  <div class="wrap">
    <nav class="nav" aria-label="Main navigation">
      <a class="logo" href="#home" aria-label="Andres Escala — home">andres<b>.dev</b></a>

      <div class="links">
        {links.map((link) => <a class="h" href={link.href}>{link.label}</a>)}
        <div class="lang" role="group" aria-label="Language / Idioma">
          <a href={localizedPath("en", path)} hreflang="en" aria-current={locale === "en" ? "true" : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={localizedPath("es", path)} hreflang="es" aria-current={locale === "es" ? "true" : undefined}>ES</a>
        </div>
        <button id="th" class="btn tg" type="button" aria-label={locale === "es" ? "Cambiar tema" : "Toggle theme"} title={locale === "es" ? "Cambiar tema" : "Toggle theme"}>◐</button>
        <button id="nav-menu-toggle" class="menu-toggle" type="button" aria-controls="nav-menu" aria-expanded="false" aria-label={locale === "es" ? "Abrir menú" : "Open menu"}>
          <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 1h16M1 7h16M1 13h16" /></svg>
        </button>
      </div>
    </nav>
  </div>

  <div id="nav-menu" class="mobile-menu">
    <a href="#home">{t.nav.home}</a>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="#stack">{t.nav.expertise}</a>
  </div>
</header>
