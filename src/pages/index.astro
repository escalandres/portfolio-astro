---
import { defaultLocale } from "../i18n";
import Layout from "../layouts/Layout.astro";

// The portfolio root redirects to the default (English) locale.
return Astro.redirect(`/${defaultLocale}`, 301);
---

<Layout title="Redirecting" description="Redirecting to the English version of the Andres Escala portfolio.">
  <main id="main-content">
    <section class="hero">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-32 md:py-40 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-ink">Redirecting…</h1>
        <p class="mt-4 text-lg text-ink-secondary">
          You are being redirected to the <a href={`/${defaultLocale}`}>English homepage</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
